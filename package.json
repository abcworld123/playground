{
  "name": "playground",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --enable-source-maps build/server.mjs",
    "dev": "cross-env NODE_ENV=development pnpm --reporter=append-only run /^dev:/",
    "dev:server": "tsx watch --clear-screen=false --env-file-if-exists=.env app.ts",
    "dev:webpack": "webpack --config=webpack.config.dev.ts",
    "build": "pnpm run /^build:/",
    "build:client": "webpack --config=webpack.config.prod.ts",
    "build:server": "tsx esbuild.config.ts",
    "lint": "eslint **/*.ts",
    "test": "jest"
  },
  "dependencies": {
    "@googleapis/youtube": "^40.0.2",
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap3": "npm:bootstrap@^3.4.1",
    "compression": "^1.8.2",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "livereload": "^0.10.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sweetalert2": "^11.26.25",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/livereload": "^0.9.5",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "purgecss-webpack-plugin": "^8.0.0",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
